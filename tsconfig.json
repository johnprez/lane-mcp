{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tsup.config.ts"],
  "comment-exclude": "src/app-src targets the browser (DOM globals) and is bundled by scripts/build-apps.mjs, not typechecked by the Node tsconfig.",
  "exclude": ["src/app-src"]
}
